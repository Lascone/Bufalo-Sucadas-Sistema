# === Servidor central ===
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL (nunca compartilhe estas credenciais com o app desktop)
DATABASE_URL=postgresql://ferrogestor:ferrogestor@localhost:5432/ferrogestor?schema=public

# Redis (opcional)
REDIS_URL=redis://localhost:6379

# Auth JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Argon2 / segurança
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# CORS (origens permitidas do desktop em dev)
CORS_ORIGINS=http://localhost:5173

# === Desktop (apps/desktop) ===
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Canal de update: stable | beta
UPDATE_CHANNEL=stable
# Owner/repo do GitHub Releases (privado requer GH_TOKEN no CI)
GH_OWNER=bufalo-sucatas
GH_REPO=ferrogestor
