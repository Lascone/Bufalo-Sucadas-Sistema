# === Servidor central (PostgreSQL 16 â€” credenciais no cÃ³digo) ===
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Opcional: sobrescrever URL do Postgres (padrÃ£o em packages/shared/src/central-config.ts)
# DATABASE_URL=

# Auth JWT (obrigatÃ³rio no servidor)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SeguranÃ§a
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# CORS
CORS_ORIGINS=http://localhost:5173

# === Desktop ===
UPDATE_CHANNEL=stable
GH_OWNER=Lascone
GH_REPO=Bufalo-Sucadas-Sistema

# SQLite local do desktop (backup/wipe â€” nÃ£o Ã© o store de negÃ³cio)
LOCAL_DATABASE_URL=file:./packages/database/prisma/local/ferrogestor-local.db
