# === Servidor central (100% local, sem Docker) ===
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL central (todos os PCs enviam dados aqui)
# DATABASE_URL=postgresql://USER:PASSWORD@seu-servidor:5432/bufalo_gestor?schema=public
DATABASE_URL=

# MongoDB legado (opcional — substituído pelo PostgreSQL em v0.2)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ferrogestor?appName=Cluster0
MONGODB_URI=

# Redis não é obrigatório
# REDIS_URL=redis://localhost:6379

# Auth JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Segurança
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# CORS
CORS_ORIGINS=http://localhost:5173

# === Desktop ===
VITE_API_BASE_URL=http://localhost:3000/api/v1
UPDATE_CHANNEL=stable
GH_OWNER=bufalo-sucatas
GH_REPO=ferrogestor

# SQLite do desktop (offline-first)
LOCAL_DATABASE_URL=file:./packages/database/prisma/local/ferrogestor-local.db
