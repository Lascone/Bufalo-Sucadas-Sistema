{
  "name": "@ferrogestor/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./central": {
      "types": "./dist/central.d.ts",
      "import": "./dist/central.js",
      "require": "./dist/central.js",
      "default": "./dist/central.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "import": "./dist/local.js",
      "require": "./dist/local.js",
      "default": "./dist/local.js"
    }
  },
  "files": [
    "dist",
    "prisma/generated/central",
    "prisma/generated/local",
    "prisma/central/schema.prisma",
    "prisma/local/schema.prisma"
  ],
  "scripts": {
    "generate": "npm run generate:central && npm run generate:local",
    "generate:central": "prisma generate --schema=prisma/central/schema.prisma",
    "generate:local": "prisma generate --schema=prisma/local/schema.prisma",
    "migrate:central": "prisma migrate dev --schema=prisma/central/schema.prisma --name init",
    "migrate:local": "prisma migrate dev --schema=prisma/local/schema.prisma --name init",
    "db:push:central": "tsx scripts/prisma-central.ts db push",
    "db:push:local": "prisma db push --schema=prisma/local/schema.prisma",
    "migrate:central:deploy": "prisma migrate deploy --schema=prisma/central/schema.prisma",
    "migrate:local:deploy": "prisma migrate deploy --schema=prisma/local/schema.prisma",
    "seed": "tsx src/seed.ts",
    "test:pg": "tsx scripts/test-pg.ts",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ferrogestor/shared": "workspace:*",
    "@prisma/client": "^6.3.1",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "argon2": "^0.41.1",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  }
}
